# 資料庫連線（必填）
# 格式：postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/podcastrag

# 前端來源（必填，CORS whitelist）
FRONTEND_ORIGIN=http://localhost:8080

# 應用程式設定（選填）
APP_ENV=development
APP_DEBUG=true

# Celery / Redis（docker-compose 預設即可）
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Whisper provider：openai 或 faster-whisper
TRANSCRIPTION_PROVIDER=openai

# 使用 openai provider 時必填
OPENAI_API_KEY=

# Zeabur AI Hub virtual/proxy token（LiteLLM gateway）
# 首次啟動時會自動 seed 到 llm_config 的 answer_api_key / rewrite_api_key（僅在欄位為空時）
ZEABUR_API_KEY=

# OpenAI Whisper 分段上傳設定（OpenAI 單次上傳上限為 25 MB）
# 超過此閾值（MB）的音訊會被自動切片，逐段呼叫 Whisper API，再合併結果
OPENAI_WHISPER_CHUNK_SIZE_MB=24
# 相鄰 chunk 之間的重疊秒數（預設 0，不重疊；本版不做重疊區去重）
OPENAI_WHISPER_CHUNK_OVERLAP_SECONDS=0

# 使用 faster-whisper provider 時可調整
FASTER_WHISPER_MODEL_SIZE=base
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_MODEL_DIR=/models/faster-whisper

# Cloudflare R2（音檔物件儲存，必填才能啟動轉錄任務）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 範例：https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# === Auth / Google SSO（必填）===
# 從 Google Cloud Console > APIs & Services > Credentials 建立 OAuth 2.0 Client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必須與 Google Cloud Console 設定的 Authorized redirect URI 完全一致
# 本機: http://localhost:8000/auth/google/callback
# Prod: https://podcastrag-api.zeabur.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# 用於簽署暫存 OAuth state cookie（建議至少 32 chars 隨機字串）
# 產生指令: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# 自動升 admin 的 email 白名單（comma-separated，留空則沒有自動 admin）
ADMIN_EMAILS=

# Session 過期天數（sliding expiration），預設 14
SESSION_TTL_DAYS=14

# === Freemium 模式（選填，皆有預設值）===
# 新使用者第一次登入時配發的 quota 數（既有使用者的 quota_initial 不會被改）
DEFAULT_USER_QUOTA=30
# 未登入訪客每 IP 每天可呼叫公開 search endpoint 的次數上限
IP_SEARCH_RATE_LIMIT_PER_DAY=20

# === ZSend Email（選填，未設則 quota digest task 會 no-op + log）===
# 從 Zeabur ZSend 後台取得；用於每天 09:00 / 21:00 UTC 彙整 quota 申請通知 admin
ZSEND_API_KEY=
# 寄件人 email（須為 ZSend 已驗證的網域 / 信箱）
ZSEND_FROM_EMAIL=
# 收件人 email（admin），逗號分隔可填多個
ZSEND_ADMIN_TO_EMAIL=

# === 多 provider 用量觀測（multi-provider-usage-monitoring change）===
#
# 兩個 adapter 皆 fail-open：未設 env 時記 warning + 回空陣列，不會阻斷整個
# Beat task。
#
# OPENAI_ORG_ADMIN_KEY：用於打 https://api.openai.com/v1/organization/costs
# 一般 API key 沒有 read_usage 權限。請到
#   https://platform.openai.com/settings/organization/admin-keys
# 產一把專用的 organization admin key（建議唯讀 scope）。
OPENAI_ORG_ADMIN_KEY=
#
# AIHUB_USAGE_KEY：DEPRECATED — 舊 REST adapter 用，已棄用（endpoint 不存在）。
# 保留 env 變數定義避免破壞既有部署，但新版 adapter 不再讀取此值。
AIHUB_USAGE_KEY=
#
# ZEABUR_API_TOKEN：用於打 Zeabur 官方 GraphQL endpoint 取 AI Hub usage。
# 取得方式：`zeabur auth login` 後從 ~/.config/zeabur/cli.yaml 複製 token 欄位。
# 未設時 adapter 會 log warning 並回 []（不會中斷 collector）。
ZEABUR_API_TOKEN=
#
# Per-provider 月度預算（USD）。當月累積 >= 80% 寄 yellow alert、>= 95% 寄 red alert。
# v1 寫死預設；v2 會加 admin UI 編輯器。
PROVIDER_BUDGET_USD_MONTHLY_AIHUB=80
PROVIDER_BUDGET_USD_MONTHLY_OPENAI=30
