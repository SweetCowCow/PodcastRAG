{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://podcastrag.app/schemas/golden-set.json",
  "title": "Golden Set",
  "description": "Per-show golden set of questions with ground-truth chunk IDs for RAG evaluation.",
  "type": "object",
  "required": ["show_slug", "show_id", "version", "created_at", "items"],
  "properties": {
    "show_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase ASCII hyphenated slug; matches the dataset filename."
    },
    "show_id": {
      "type": "string",
      "description": "Show UUID from the database."
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(-[a-z]+)?$",
      "description": "Main dataset versions use vN (v1, v2…). Staging files MAY append a `-pending` suffix (e.g. v2-pending) to indicate pre-review status."
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/Item" }
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "eval_mode",
        "question",
        "expected_answer_keywords",
        "ground_truth_chunk_ids",
        "sentinel",
        "source_episode_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "enum": ["fact", "comprehension", "cross-episode", "negative", "code-switch"]
        },
        "eval_mode": {
          "enum": ["chunk_id", "open_set_lenient", "enumeration"],
          "description": "Scoring contract the eval runner applies to this item. chunk_id: classic Recall@K against ground_truth_chunk_ids (empty gt → None, excluded from mean — used for negative items). open_set_lenient: any-anchor-hit → recall 1.0, else 0.0. enumeration: ignore ground_truth_chunk_ids and compute episode-set recall against expected_episode_ids."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expected_answer_keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "minItems": 0,
          "maxItems": 10
        },
        "ground_truth_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ep:[0-9a-f-]+@[0-9]+\\.[0-9]{2}$"
          }
        },
        "expected_episode_ids": {
          "type": "array",
          "description": "Required and non-empty when eval_mode=enumeration. Forbidden (absent or empty) for other modes. Lists episode UUIDs the runner expects to appear in the retrieval result set; runner computes episode-set recall = |retrieved ∩ expected| / |expected|.",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "sentinel": { "type": "boolean" },
        "source_episode_id": {
          "type": "string",
          "description": "Primary episode UUID this item is anchored to."
        }
      },
      "allOf": [
        {
          "description": "eval_mode=enumeration requires non-empty expected_episode_ids",
          "if": {
            "required": ["eval_mode"],
            "properties": { "eval_mode": { "const": "enumeration" } }
          },
          "then": {
            "required": ["expected_episode_ids"],
            "properties": {
              "expected_episode_ids": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "description": "Non-enumeration items MUST NOT carry non-empty expected_episode_ids",
          "if": {
            "required": ["eval_mode"],
            "properties": { "eval_mode": { "enum": ["chunk_id", "open_set_lenient"] } }
          },
          "then": {
            "properties": {
              "expected_episode_ids": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
